{
  "name": "hyperswitch",
  "version": "0.1.0",
  "description": "Provider and model configuration manager",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": {
    "name": "HyperSwitch",
    "email": "Wanxiaace@users.noreply.github.com"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:linux": "npm run build && electron-builder --linux --publish never",
    "postinstall": "node scripts/ensure-electron.cjs && electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.22",
    "vue-router": "^5.3.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
